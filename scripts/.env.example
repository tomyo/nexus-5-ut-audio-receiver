# Nexus 5 Audio Receiver Configuration Example
# Copy this file to config.env and fill in your values.
# DO NOT commit the real config.env with credentials!
DEVICE_NAME="YourDeviceName"
PA_UID="YourPulseAudioUID"
SUDO_PIN="YourSudoPassword"
CPU_GOVERNOR="performance"
BITRATE="320"
PHONE_HOST="192.168.x.x"
